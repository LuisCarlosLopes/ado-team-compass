<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Situação atual — {{ report.team_alias }} — {{ report.iteration_path or "janela de análise" }}</title>
<style>
  :root {
    color-scheme: light dark;
    --fundo: #ffffff; --texto: #16191d; --borda: #c9ced6; --suave: #f4f6f9;
    --atencao: #8a5300; --acima: #8c1d18; --ok: #1c5c2e; --indisponivel: #4a5158;
    --tinta-suave: #6b7280; --hachura: rgba(140, 29, 24, .16);
  }
  @media (prefers-color-scheme: dark) {
    :root { --fundo: #14171a; --texto: #eceff3; --borda: #3a4149; --suave: #1d2126;
            --atencao: #e0a458; --acima: #f28b82; --ok: #7fd18f; --indisponivel: #a8b0b8;
            --tinta-suave: #9aa3ad; --hachura: rgba(242, 139, 130, .18); }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 2rem 2.25rem 2.5rem; background: var(--fundo); color: var(--texto);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
         -webkit-font-smoothing: antialiased; }
  main { display: flex; flex-direction: column; gap: 1.75rem; max-width: 78rem; margin: 0 auto; }
  h1 { font-size: 1.75rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.15;
       margin: 0; }
  h2 { font-size: 1.05rem; font-weight: 650; margin: 0 0 .5rem;
       border-bottom: 1px solid var(--borda); padding-bottom: .35rem; }
  h3 { font-size: .95rem; font-weight: 650; margin: 1rem 0 .4rem; }
  .num { font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  table { border-collapse: collapse; width: 100%; margin: .4rem 0 .5rem; font-size: .88rem; }
  caption { text-align: left; font-size: .8rem; color: var(--tinta-suave); padding: .3rem 0; }
  th, td { border: 1px solid var(--borda); padding: .4rem .55rem; text-align: left;
           vertical-align: top; }
  th { background: var(--suave); font-weight: 600; }
  .envelope { overflow-x: auto; }
  .rotulo { font-size: .74rem; text-transform: uppercase; letter-spacing: .06em;
            color: var(--tinta-suave); font-weight: 650; }

  /* faixa de contexto */
  .contexto { display: flex; justify-content: space-between; align-items: flex-start;
              gap: 1.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--borda);
              padding-bottom: 1rem; }
  .contexto .escopo { font-size: .95rem; color: var(--tinta-suave); }
  .contexto .lado { display: flex; flex-direction: column; align-items: flex-end; gap: .4rem;
                    text-align: right; font-size: .8rem; color: var(--tinta-suave); }
  .estado { display: inline-flex; align-items: center; gap: .4rem; border: 1px solid currentColor;
            border-radius: 999px; padding: .15rem .7rem; font-size: .78rem; font-weight: 600; }
  .estado.parcial { color: var(--atencao); }
  .estado.completa { color: var(--ok); }

  /* veredito */
  .veredito { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.75rem;
              align-items: start; border: 1px solid var(--borda); border-left: 5px solid
              var(--indisponivel); border-radius: .5rem; padding: 1.5rem 1.6rem;
              background: var(--suave); }
  .veredito.acima { border-left-color: var(--acima); }
  .veredito.ok { border-left-color: var(--ok); }
  .veredito .texto { grid-column: span 5; display: flex; flex-direction: column; gap: .6rem; }
  .veredito .medida { grid-column: span 7; display: flex; flex-direction: column; gap: .75rem; }
  .veredito .chamada { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em;
                       font-weight: 700; color: var(--indisponivel); }
  .veredito.acima .chamada { color: var(--acima); }
  .veredito.ok .chamada { color: var(--ok); }
  .veredito h1 { font-size: 1.5rem; font-weight: 650; line-height: 1.22; text-wrap: pretty; }
  .veredito .detalhe { font-size: .95rem; color: var(--tinta-suave); text-wrap: pretty; }
  .veredito .aviso { font-size: .82rem; color: var(--tinta-suave);
                     border-top: 1px dashed var(--borda); padding-top: .6rem; }
  .destaque { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
              flex-wrap: wrap; }
  .destaque .gap { font-size: 2.6rem; font-weight: 750; line-height: 1; }
  .destaque .gap.acima { color: var(--acima); }
  .destaque .lado { text-align: right; }
  .destaque .utilizacao { font-size: 1.3rem; font-weight: 700; line-height: 1.1; }

  /* barra proporcional */
  figure.barra { margin: 0; }
  figure.barra svg { display: block; border: 1px solid var(--borda); border-radius: .35rem; }
  .cabe { fill: var(--ok); }
  .excede { color: var(--acima); }
  .folga-reserva { fill: none; stroke: var(--borda); stroke-dasharray: 4 3; }
  .rotulo-barra { font: 650 12px system-ui, sans-serif; fill: var(--fundo); }
  .rotulo-excede { font: 650 12px system-ui, sans-serif; fill: var(--acima); }
  .rotulo-folga { font: 650 12px system-ui, sans-serif; fill: var(--tinta-suave); }
  figure.barra figcaption { font-size: .76rem; color: var(--tinta-suave); margin-top: .35rem; }
  .limite { display: flex; align-items: flex-start; gap: .5rem; font-size: .82rem;
            color: var(--atencao); border: 1px solid var(--atencao); border-radius: .35rem;
            padding: .5rem .7rem; }

  /* dias da sprint */
  .dias { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: .35rem; }
  .dia { border: 1px solid var(--borda); border-radius: .3rem; padding: .45rem .2rem;
         text-align: center; }
  .dia .semana { font-size: .7rem; color: var(--tinta-suave); }
  .dia .numero { font-weight: 650; }
  .dia.passado { background: repeating-linear-gradient(135deg, rgba(0,0,0,.05) 0 5px,
                 transparent 5px 10px); color: var(--tinta-suave); }
  .dia.nao_util { border-style: dashed; color: var(--tinta-suave); }
  .dia.elegivel { border-color: var(--ok); color: var(--ok); }
  .dia.folga { border-color: var(--atencao); color: var(--atencao);
               background: repeating-linear-gradient(135deg, var(--hachura) 0 5px,
               transparent 5px 10px); }
  .dia.hoje { border: 2px solid var(--texto); color: var(--texto); padding: .4rem .2rem; }

  /* cartões */
  .cartoes { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
             gap: .85rem; margin: 0; padding: 0; list-style: none; }
  .cartao { border: 1px solid var(--borda); border-radius: .5rem; padding: .85rem 1rem;
            display: flex; flex-direction: column; gap: .15rem; }
  .cartao .valor { font-size: 1.8rem; font-weight: 700; line-height: 1.15; }
  .cartao .valor.pequeno { font-size: 1.05rem; font-weight: 600; }
  .cartao .nota { font-size: .78rem; color: var(--tinta-suave); text-wrap: pretty; }

  /* decisões */
  .decisao { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 16rem; gap: 1rem;
             align-items: start; border: 1px solid var(--borda); border-radius: .5rem;
             padding: .85rem 1rem; }
  .decisao + .decisao { margin-top: .6rem; }
  .decisao .ordem { width: 1.9rem; height: 1.9rem; border-radius: 50%; display: flex;
                    align-items: center; justify-content: center; font-weight: 700;
                    font-size: .9rem; background: var(--indisponivel); color: var(--fundo); }
  .decisao .ordem.acima { background: var(--acima); }
  .decisao .ordem.atencao { background: var(--atencao); }
  .decisao .acao { font-weight: 650; }
  .decisao .problema { font-size: .88rem; color: var(--tinta-suave); text-wrap: pretty; }
  .decisao .confirmar { font-size: .78rem; color: var(--tinta-suave);
                        border-left: 2px solid var(--borda); padding-left: .75rem;
                        text-wrap: pretty; }
  .decisao .confirmar strong { color: var(--texto); display: block; }

  /* limites */
  .limites { border: 1px solid var(--borda); border-radius: .5rem; padding: 1rem 1.1rem;
             background: var(--suave); }
  .limites .grade { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
                    gap: 1rem; margin-top: .6rem; }
  .limites .item { font-size: .84rem; color: var(--tinta-suave);
                   border-left: 3px solid var(--indisponivel); padding-left: .65rem;
                   text-wrap: pretty; }
  .limites .item strong { color: var(--texto); display: block; }

  .selo { display: inline-block; border: 1px solid currentColor; border-radius: .25rem;
          padding: 0 .3rem; font-size: .74rem; font-weight: 650; }
  .ACIMA_DA_FAIXA, .CARGA_SEM_CAPACIDADE { color: var(--acima); }
  .ATENCAO { color: var(--atencao); }
  .DENTRO_DA_FAIXA, .ok { color: var(--ok); }
  .DADOS_INSUFICIENTES, .SEM_CARGA_REGISTRADA, .SEM_RESPONSAVEL { color: var(--indisponivel); }
  .indisponivel { border-left: 3px solid var(--indisponivel); padding-left: .75rem;
                  color: var(--indisponivel); }
  .barra-pessoa { display: flex; height: .6rem; border: 1px solid var(--borda);
                  border-radius: .2rem; overflow: hidden; min-width: 6rem; }
  .barra-pessoa .cabe-p { background: var(--ok); }
  .barra-pessoa .excede-p { background: repeating-linear-gradient(135deg, var(--hachura) 0 6px,
                            transparent 6px 12px); }
  .filtros { display: flex; flex-wrap: wrap; gap: .75rem; align-items: end; margin: .5rem 0; }
  .filtros label { display: flex; flex-direction: column; font-size: .82rem; gap: .2rem; }
  .selecao { font-size: .82rem; color: var(--tinta-suave); }
  details > summary { cursor: pointer; margin: .4rem 0; }
  .rodape { display: flex; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
            border-top: 1px solid var(--borda); padding-top: .9rem; font-size: .78rem;
            color: var(--tinta-suave); }
  @media (max-width: 60rem) {
    .veredito .texto, .veredito .medida { grid-column: span 12; }
    .decisao { grid-template-columns: 2rem minmax(0, 1fr); }
    .decisao .confirmar { grid-column: 2; border-left: none; padding-left: 0;
                          border-top: 1px solid var(--borda); padding-top: .5rem; }
    .dias { grid-auto-flow: row; grid-template-columns: repeat(7, minmax(0, 1fr));
            grid-auto-columns: auto; }
  }
  @media print {
    body { padding: 0; }
    .filtros, .acoes-pagina { display: none; }
    .veredito, .limites { background: transparent; }
    table { page-break-inside: auto; }
  }
</style>
</head>
<body>
<main>
<div class="contexto">
  <div>
    <div class="rotulo">Situação atual da sprint</div>
    <h1>{{ report.team_alias }}</h1>
    <div class="escopo">
      {{ report.iteration_path or "janela de análise sem iteração" }}
      {% if report.window %}&middot; {{ context.window_label }}{% endif %}
      &middot; {{ report.profile }}
    </div>
  </div>
  <div class="lado">
    {% if report.partial_sources %}
    <span class="estado parcial">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 8v5"></path><path d="M12 16.5v.5"></path><circle cx="12" cy="12" r="9"></circle></svg>
      Coleta parcial
    </span>
    <span>Fontes parciais: {{ report.partial_sources | join(", ") }}</span>
    {% else %}
    <span class="estado completa">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4 10-10"></path></svg>
      Coleta completa
    </span>
    <span>Nenhuma fonte parcial registrada</span>
    {% endif %}
    <span>Referência {{ report.as_of }}</span>
  </div>
</div>

<section class="veredito {{ verdict.tone }}" aria-label="Leitura da execução">
  <div class="texto">
    <div class="chamada">{{ verdict.eyebrow }}</div>
    <h1>{{ verdict.headline }}</h1>
    <p class="detalhe" style="margin: 0;">{{ verdict.subline }}</p>
    <p class="aviso" style="margin: 0;">{{ gap.gap_note }}</p>
  </div>
  <div class="medida">
    <div class="destaque">
      <div style="display: flex; align-items: baseline; gap: .6rem;">
        <span class="num gap {{ verdict.tone }}">{{ gap.gap }}</span>
        <span class="detalhe">{{ context.gap_label }}</span>
      </div>
      <div class="lado">
        <div class="num utilizacao {{ verdict.tone }}">{{ gap.utilization }}</div>
        <div class="selecao">utilização observada &middot; {{ gap.utilization_note }}</div>
      </div>
    </div>
    {{ capacity_svg }}
    {% if context.lower_bound %}
    <p class="limite" style="margin: 0;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: .15rem;"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg>
      <span><strong>Limite inferior:</strong> {{ context.lower_bound }}</span>
    </p>
    {% endif %}
  </div>
</section>

{% if report.days %}
<section aria-label="Dias da janela">
  <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
    <h2 style="border: none; margin: 0; padding: 0;">Dias da janela</h2>
    <span class="selecao">
      {{ report.remaining_working_days }} dias úteis restantes
      {%- if report.personal_days_off %} &middot; {{ report.personal_days_off }} folgas pessoais conhecidas{% endif %}
      &middot; {{ context.current_day_policy }}
    </span>
  </div>
  <div class="dias">
    {% for day in report.days %}
    <div class="dia {{ day.kind }}{% if day.is_today %} hoje{% endif %}">
      <div class="semana">{% if day.is_today %}hoje{% else %}{{ day.weekday_label }}{% endif %}</div>
      <div class="numero num">{{ day.day_label }}</div>
    </div>
    {% endfor %}
  </div>
  <details>
    <summary class="selecao">Tabela equivalente dos dias da janela</summary>
    <div class="envelope">
    <table>
      <thead><tr><th>Data</th><th>Dia</th><th>Situação</th></tr></thead>
      <tbody>
        {% for day in report.days %}
        <tr><td>{{ day.date }}</td><td>{{ day.weekday_label }}</td><td>{{ day.kind }}{% if day.is_today %} (dia corrente){% endif %}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{% endif %}

<section aria-label="Fatos do escopo observado">
  <ul class="cartoes">
  {% for card in cards %}
    <li class="cartao">
      <span class="rotulo">{{ card.label }}</span>
      <span class="valor {{ card.css_class }}{% if card.value in ("não aplicável", "indisponível", "não informado") %} pequeno{% endif %}">{{ card.value }}</span>
      <span class="nota">{{ card.note }}</span>
    </li>
  {% endfor %}
  </ul>
</section>

{% if candidates %}
<section aria-label="Decisões prioritárias">
  <h2>Três decisões prioritárias</h2>
  <p class="selecao" style="margin: 0 0 .6rem;">Ação recomendada não é ação executada: este relatório não altera nada no Azure DevOps.</p>
  {% for candidate in candidates[:3] %}
  <div class="decisao">
    <div class="ordem {% if candidate.priority <= 2 %}acima{% elif candidate.priority == 3 %}atencao{% endif %} num">{{ loop.index }}</div>
    <div>
      <div class="acao">{{ candidate.action }}</div>
      <div class="problema">{{ candidate.problem }} {{ candidate.observed_impact }}</div>
      <div class="selecao" style="margin-top: .3rem;">Quem decide: {{ candidate.decision_role }} &middot; Como verificar: {{ candidate.verification }} &middot; Evidência: {{ candidate.evidence | join(", ") }}</div>
    </div>
    <div class="confirmar"><strong>Confirmar antes</strong>{{ candidate.to_confirm }}</div>
  </div>
  {% endfor %}
</section>
{% endif %}

<h2>Métricas da execução</h2>
<div class="envelope">
<table id="tabela-metricas">
  <caption>Cada número tem status, cobertura de itens e motivo quando não está disponível</caption>
  <thead>
    <tr><th>Métrica</th><th>Status</th><th>Valor</th><th>Cobertura de itens</th><th>Motivo</th></tr>
  </thead>
  <tbody>
  {% for metric in report.metrics %}
    <tr>
      <td><code>{{ metric.id }}</code></td>
      <td>{{ metric.status.value }}</td>
      <td>{{ fmt_metric(metric) }}</td>
      <td>{{ fmt_coverage(metric.coverage) }}</td>
      <td>{{ metric.unavailable_reason or "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2>Planejamento de capacidade e carga conhecida</h2>
<div class="envelope">
<table>
  <caption>Carga conhecida contra capacidade restante reservada, na mesma janela e unidade</caption>
  <thead><tr><th>Medida</th><th>Valor</th><th>Observação</th></tr></thead>
  <tbody>
    <tr><th scope="row">Carga restante conhecida</th><td>{{ gap.load }}</td><td>{{ gap.load_note }}</td></tr>
    <tr><th scope="row">Capacidade restante reservada</th><td>{{ gap.capacity }}</td><td>{{ gap.capacity_note }}</td></tr>
    <tr><th scope="row">Gap de capacidade atual</th><td>{{ gap.gap }}</td><td>{{ gap.gap_note }}</td></tr>
    <tr><th scope="row">Utilização observada</th><td>{{ gap.utilization }}</td><td>{{ gap.utilization_note }}</td></tr>
    <tr><th scope="row">Variação da estimativa total</th><td>indisponível</td>
        <td>exige baseline congelada da mesma coorte; entra na v0.2</td></tr>
    <tr><th scope="row">Desvio final registrado</th><td>indisponível</td>
        <td>exige prática confiável de registro e período compatível; entra na v0.2</td></tr>
  </tbody>
</table>
</div>

<h3>Carga por pessoa</h3>
<form class="filtros" id="filtros" onsubmit="return false;">
  <label>Pessoa
    <input type="search" id="filtro-pessoa" placeholder="parte do identificador">
  </label>
  <label>Classe
    <select id="filtro-classe">
      <option value="">todas</option>
      {% for classe in classes %}<option value="{{ classe }}">{{ classe }}</option>{% endfor %}
    </select>
  </label>
  <p class="selecao" id="selecao-ativa">Sem filtro: {{ people | length }} pessoas exibidas.</p>
</form>
<div class="envelope">
<table id="tabela-pessoas">
  <caption>Carga conhecida por pessoa. O total da sprint permanece na tabela acima, mesmo com filtro.</caption>
  <thead>
    <tr><th>Pessoa</th><th>Carga conhecida</th><th>Capacidade restante</th><th>Utilização</th>
        <th>Classe</th><th>Itens elegíveis</th><th>Com valor</th><th>Sem valor</th><th>Observação</th></tr>
  </thead>
  <tbody>
  {% for row in people %}
    <tr data-pessoa="{{ row.person_id }}" data-classe="{{ row.load_class }}">
      <td><code>{{ row.person_id }}</code></td>
      <td>
        {{ fmt_quantity(row.known_load) }}
        {% if row.bar %}
        <span class="barra-pessoa" role="img" aria-label="{{ row.bar.label }}">
          <span class="cabe-p" style="width: {{ row.bar.fits }}%"></span>
          <span class="excede-p" style="width: {{ row.bar.excess }}%"></span>
        </span>
        {% endif %}
      </td>
      <td>{{ fmt_quantity(row.reserved_capacity) }}</td>
      <td>{{ fmt_ratio(row.utilization) }}{% if row.is_lower_bound %} (limite inferior){% endif %}</td>
      <td><span class="selo {{ row.load_class }}">{{ row.load_class }}</span></td>
      <td>{{ row.items_eligible }}</td><td>{{ row.items_known }}</td><td>{{ row.items_missing }}</td>
      <td>{{ row.reason or "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2>Impedimentos explícitos</h2>
{% if impediments %}
<div class="envelope">
<table>
  <caption>Itens marcados pela origem de impedimento configurada</caption>
  <thead><tr><th>Item</th><th>Título (excerto)</th><th>Estado</th><th>Responsável</th>
             <th>Desde quando</th><th>Evidência</th></tr></thead>
  <tbody>
  {% for item in impediments %}
    <tr>
      <td>{{ item.id }}</td>
      <td>{{ item.title or "—" }}</td>
      <td>{{ item.state }}</td>
      <td><code>{{ item.assigned_to or "—" }}</code></td>
      <td>desconhecido: sem evento de início do bloqueio</td>
      <td><code>evidence/items/{{ item.id }}.json</code></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="selecao">Ausência de registro não prova ausência de impedimento, e o responsável pela resolução não é inferido do responsável pelo item.</p>
{% else %}
<p class="indisponivel">Nenhum item marcado como impedido pela origem configurada. Isso não prova ausência de impedimentos.</p>
{% endif %}

<h2>Histórico observado</h2>
{% if report.history and report.history.available %}
<div class="envelope">
<table>
  <caption>Compromisso, escopo e fluxo observados na janela, com coorte explícita</caption>
  <tbody>
    <tr><th scope="row">Baseline</th>
        <td>{{ report.history.baseline_label }} · {{ report.history.baseline_size }} itens
        {% if report.history.baseline_is_technical %}(baseline técnica: não prova compromisso confirmado){% endif %}</td></tr>
    <tr><th scope="row">Say/do</th>
        <td>{{ fmt_ratio(report.history.say_do) }}
        ({{ report.history.say_do_numerator }}/{{ report.history.say_do_denominator }})</td></tr>
    <tr><th scope="row">Carry-over da baseline</th><td>{{ fmt_ratio(report.history.carry_over) }}</td></tr>
    <tr><th scope="row">Escopo: entradas</th><td>{{ report.history.scope_entered | join(", ") or "nenhuma" }}</td></tr>
    <tr><th scope="row">Escopo: saídas</th><td>{{ report.history.scope_exited | join(", ") or "nenhuma" }}</td></tr>
    <tr><th scope="row">Entrou e saiu na mesma janela</th><td>{{ report.history.scope_round_trip | join(", ") or "nenhum" }}</td></tr>
    <tr><th scope="row">Pontos comprometidos / atuais</th>
        <td>{{ report.history.committed_points if report.history.committed_points is not none else "indisponível" }}
            / {{ report.history.current_points if report.history.current_points is not none else "indisponível" }}
            {% if report.history.points_changed_item_ids %}· reestimados: {{ report.history.points_changed_item_ids | join(", ") }}{% endif %}</td></tr>
    <tr><th scope="row">Cycle time p50 / p85</th>
        <td>{{ report.history.cycle_time_p50 if report.history.cycle_time_p50 is not none else "nulo" }}
            / {{ report.history.cycle_time_p85 if report.history.cycle_time_p85 is not none else "nulo" }}
            dias corridos (nearest-rank, amostra {{ report.history.cycle_time_sample }})</td></tr>
    <tr><th scope="row">Lead time p50</th>
        <td>{{ report.history.lead_time_p50 if report.history.lead_time_p50 is not none else "nulo" }}
            dias corridos (amostra {{ report.history.lead_time_sample }}); não é tempo até valor em produção</td></tr>
    <tr><th scope="row">Reaberturas concluídas de novo</th><td>{{ report.history.reopened_item_ids | join(", ") or "nenhuma" }}</td></tr>
    <tr><th scope="row">Aging do episódio mais antigo</th>
        <td>{{ report.history.oldest_aging_days if report.history.oldest_aging_days is not none else "desconhecido" }} dias
        {% if report.history.aging_unknown_item_ids %}· início desconhecido: {{ report.history.aging_unknown_item_ids | join(", ") }}{% endif %}</td></tr>
  </tbody>
</table>
</div>
{% if report.history.throughput %}
<div class="envelope">
<table>
  <caption>Throughput por semana (primeira conclusão); semanas sem entrega permanecem com zero</caption>
  <thead><tr><th>Semana</th><th>Itens concluídos</th></tr></thead>
  <tbody>
  {% for point in report.history.throughput %}
    <tr><td>{{ point.period }}</td><td>{{ point.value }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% if report.history.small_sample %}
<p class="indisponivel">Amostra pequena: percentis são indicativos e não constituem previsão.</p>
{% endif %}
<p class="selecao">Série descritiva: variação entre janelas não demonstra melhora ou piora sem contexto e cobertura.</p>
{% else %}
<p class="indisponivel">
  Burnup, burndown, baseline de esforço, duração de bloqueios, aging e tempo em fila ficam
  indisponíveis nesta execução: exigem coortes e cortes históricos com cobertura demonstrada.
  Nenhum dia passado é desenhado por interpolação e nenhum gráfico fictício é exibido.
  {% if report.history %}<br>Motivo: {{ report.history.reasons | join("; ") }}{% endif %}
</p>
{% endif %}

<h2>Achados</h2>
{% if report.findings %}
<div class="envelope">
<table>
  <caption>Achados determinísticos com item, evidência e o que confirmar</caption>
  <thead><tr><th>Severidade</th><th>Regra</th><th>Mensagem</th><th>Itens</th><th>Evidência</th><th>A confirmar</th></tr></thead>
  <tbody>
  {% for finding in report.findings %}
    <tr>
      <td>{{ finding.severity }}</td><td><code>{{ finding.rule_id }}</code></td>
      <td>{{ finding.message }}</td>
      <td>{{ finding.item_ids | join(", ") or "—" }}</td>
      <td>{{ finding.evidence | join(", ") or "—" }}</td>
      <td>{{ finding.condition_to_confirm or "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p class="indisponivel">Nenhum achado determinístico nesta execução.</p>
{% endif %}

<h2>Limitações</h2>
<ul>
{% for note in report.limitations %}<li>{{ note }}</li>{% endfor %}
{% if not report.limitations %}<li>Nenhuma limitação registrada.</li>{% endif %}
</ul>

<h2>Decisões humanas</h2>
<div class="acoes-pagina">
  <p class="selecao">
    Rascunho de decisões fica apenas na memória desta página. Fechar sem exportar não preserva
    alterações, e nada é sincronizado nem escrito no Azure DevOps.
  </p>
  <button type="button" id="exportar-decisoes">Exportar rascunho de decisões (JSON)</button>
  <pre id="saida-decisoes" hidden></pre>
</div>

<p class="rodape">
  Nenhum número desta página foi calculado por modelo de linguagem. Classes de carga não medem
  produtividade individual e ausência de registro não é ociosidade. Os mesmos números estão em
  <code>metrics.json</code> e em <code>report.md</code> desta execução.
</p>
</main>
<script>
(function () {
  "use strict";
  var candidatos = {{ candidates_json }};
  var runId = {{ run_id_json }};
  var linhas = Array.prototype.slice.call(
    document.querySelectorAll("#tabela-pessoas tbody tr")
  );
  var pessoa = document.getElementById("filtro-pessoa");
  var classe = document.getElementById("filtro-classe");
  var selecao = document.getElementById("selecao-ativa");

  function aplicar() {
    var termo = (pessoa.value || "").toLowerCase();
    var alvo = classe.value || "";
    var visiveis = 0;
    linhas.forEach(function (linha) {
      var casaPessoa = linha.dataset.pessoa.toLowerCase().indexOf(termo) !== -1;
      var casaClasse = !alvo || linha.dataset.classe === alvo;
      var mostrar = casaPessoa && casaClasse;
      linha.hidden = !mostrar;
      if (mostrar) { visiveis += 1; }
    });
    var filtroAtivo = termo || alvo;
    selecao.textContent = filtroAtivo
      ? "Filtro ativo (" + (alvo || "qualquer classe") + "): " + visiveis +
        " de " + linhas.length + " pessoas. O total da sprint continua sendo o da tabela de capacidade."
      : "Sem filtro: " + linhas.length + " pessoas exibidas.";
  }

  pessoa.addEventListener("input", aplicar);
  classe.addEventListener("change", aplicar);

  document.getElementById("exportar-decisoes").addEventListener("click", function () {
    var registro = {
      decisions: candidatos.map(function (candidato) {
        return {
          id: candidato.id,
          origin_run_id: runId,
          finding_id: candidato.rule_id,
          statement: candidato.action,
          status: "proposta",
          evidence: candidato.evidence,
          recorded_at: new Date().toISOString(),
          recorded_by: "rascunho-local"
        };
      })
    };
    var saida = document.getElementById("saida-decisoes");
    saida.textContent = JSON.stringify(registro, null, 2);
    saida.hidden = false;
  });
})();
</script>
</body>
</html>
